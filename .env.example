# The committed .env holds the project's public Firebase web config.
# To point a local build somewhere else, override these in .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Set to "true" to use local emulators (npm run emulators) instead of the real project.
VITE_USE_EMULATORS=
